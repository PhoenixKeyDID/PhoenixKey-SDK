// Type-checks the tests as well as `src/`.
//
// The published build (`tsconfig.json`) is scoped to `rootDir: "src"` and
// includes only `src/**/*`, and ts-jest transpiles with `isolatedModules`,
// which skips type checking entirely. Between the two, nothing ever
// type-checked `test/**` — a test could assert against a property the type
// does not have and still go green, because TS types are erased and the mock
// supplies the key at runtime.
//
// This config exists so that a test naming a wire field is a real compile-time
// assertion about the type, not just a statement about the mock.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["jest", "node"]
  },
  "include": ["src/**/*", "test/**/*"]
}
